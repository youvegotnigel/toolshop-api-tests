    "POST /users/register",
    "POST /users/login",
    "GET /users/me",
    "GET /products",
    "GET /products/search",
    "GET /products/{productId}",
    "POST /carts",
    "POST /carts/{id}",
    "GET /carts/{cartId}",
    "PUT /carts/{cartId}/product/quantity",
    "POST /payment/check",
    "POST /invoices",
    "GET /invoices/{invoiceId}"
  ]
}
