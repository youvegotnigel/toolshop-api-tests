{
  "suite": {
    "name": "Toolshop API tests",
    "framework": "Playwright",
    "group": "Toolshop · API regression"
  },
  "targetCoverage": 80,
  "staleAfterHours": 48,
  "projects": ["api"],
  "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
