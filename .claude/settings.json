{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run verify)",
      "Bash(npm test)",
      "Bash(npm run test:stub)",
      "Bash(npm run spec:check)",
      "Bash(npx playwright test:*)",
      "Bash(npx cross-env TEST_ENV=stub npx playwright test:*)",
      "Bash(node scripts/spec-drift.mts:*)",
      "Bash(node scripts/agent-parity.mts)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": ["Read(./.env.local)", "Read(./.env)", "Bash(curl:*refresh*)", "Bash(git push --force:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/lint-edited-file.mjs", "timeout": 60 }]
      }
    ]
  }
}
