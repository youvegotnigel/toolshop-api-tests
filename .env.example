# Copy to .env.local (git-ignored) and fill in. CI uses repository secrets with the same names.
# Public Toolshop demo passwords are published at https://github.com/testsmith-io/practice-software-testing
ADMIN_PASSWORD=
# No customer password needed: each run registers its own throwaway customer.

# Optional
# TEST_ENV=public        # public (default) | stub
# LOG_LEVEL=info         # debug | info | warn | error
# ALLURE=1               # also write allure-results/
